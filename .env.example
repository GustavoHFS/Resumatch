# Directory holding private profile, configs, SQLite DB, and exported A4 PDFs
DATA_DIR=./user_data

# Local Backend API Settings
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Background Job Discovery Scheduler (disabled by default; can be toggled in UI)
SCHEDULER_ENABLED=false
SCHEDULER_DEFAULT_INTERVAL_MINUTES=360

# Playwright Headless Chromium PDF Renderer Lifecycle
PDF_BROWSER_IDLE_TIMEOUT_SECONDS=120

# Surgical AI Fine-Tuning Adapter (Optional — "none" enforces 100% deterministic mode)
# Supported values: none | gemini | groq | ollama
LLM_PROVIDER=none

# Cloud Free-Tier Providers (PII is automatically stripped before any request)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 100% Offline Local Provider
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
